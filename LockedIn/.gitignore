# Unity generated folders (Unity rebuilds these automatically)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Keep .meta files for assets (Unity needs them to link references)
!/[Aa]ssets/**/*.meta

# IDE / Visual Studio / Rider files (regenerated by Unity)
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Meta files for ignored files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
mono_crash.*

# Build outputs
*.apk
*.aab
*.unitypackage
*.app
*.exe

# Burst / IL2CPP debug info
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItInABuild/

# OS junk
.DS_Store
Thumbs.db
Desktop.ini
